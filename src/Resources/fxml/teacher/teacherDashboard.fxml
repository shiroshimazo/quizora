<?xml version="1.0" encoding="UTF-8"?>
<?import quizora.ui.HugeIcon?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="quizora.dashboard.PanelController" prefWidth="1440" prefHeight="900" minWidth="0" minHeight="0"
    styleClass="dashboard-shell" stylesheets="@../../css/dashboard.css">
    <fx:define><ToggleGroup fx:id="navigationGroup"/></fx:define>
    <left>
        <VBox fx:id="sidebarPane" prefWidth="280" minWidth="280" maxWidth="280" styleClass="sidebar">
            <VBox spacing="6" styleClass="brand-block">
                <Label text="Quizora" styleClass="brand-title"/>
                <Label text="Teacher panel" styleClass="role-label"/>
            </VBox>
            <Label text="WORKSPACE" styleClass="navigation-caption"/>
            <VBox spacing="5">
                <ToggleButton fx:id="dashboardButton" text="Dashboard" accessibleText="Dashboard" toggleGroup="$navigationGroup" selected="true" onAction="#navigate" maxWidth="Infinity" wrapText="true" styleClass="navigation-button" graphicTextGap="8"><graphic><HugeIcon name="dashboard-square-01"/></graphic></ToggleButton>
                <ToggleButton fx:id="createQuizButton" text="Create Quiz" accessibleText="Create Quiz" toggleGroup="$navigationGroup" selected="false" onAction="#navigate" maxWidth="Infinity" wrapText="true" styleClass="navigation-button" graphicTextGap="8"><graphic><HugeIcon name="add-01"/></graphic></ToggleButton>
                <ToggleButton fx:id="assignedSubjectsButton" text="Assigned Subjects" accessibleText="Assigned Subjects" toggleGroup="$navigationGroup" selected="false" onAction="#navigate" maxWidth="Infinity" wrapText="true" styleClass="navigation-button" graphicTextGap="8"><graphic><HugeIcon name="book-open-01"/></graphic></ToggleButton>
                <ToggleButton fx:id="studentResultsButton" text="Student Results" accessibleText="Student Results" toggleGroup="$navigationGroup" selected="false" onAction="#navigate" maxWidth="Infinity" wrapText="true" styleClass="navigation-button" graphicTextGap="8"><graphic><HugeIcon name="award-01"/></graphic></ToggleButton>
                <ToggleButton fx:id="quizStatisticsButton" text="Quiz Statistics" accessibleText="Quiz Statistics" toggleGroup="$navigationGroup" selected="false" onAction="#navigate" maxWidth="Infinity" wrapText="true" styleClass="navigation-button" graphicTextGap="8"><graphic><HugeIcon name="analytics-01"/></graphic></ToggleButton>
                <ToggleButton fx:id="profileButton" text="Profile" accessibleText="Profile" toggleGroup="$navigationGroup" selected="false" onAction="#navigate" maxWidth="Infinity" wrapText="true" styleClass="navigation-button" graphicTextGap="8"><graphic><HugeIcon name="user-circle"/></graphic></ToggleButton>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="sidebar-footer">
                <Button fx:id="logoutButton" text="Logout" accessibleText="Log out and return to login" onAction="#logout" maxWidth="Infinity" styleClass="logout-button" graphicTextGap="8"><graphic><HugeIcon name="logout-01"/></graphic></Button>
            </VBox>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="workspacePane" accessibleText="Dashboard workspace" styleClass="workspace">
            <fx:include fx:id="dashboardContent" source="overview.fxml"/>
            <fx:include fx:id="teacherProfileContent" source="profile.fxml"/>
            <fx:include fx:id="quizStatisticsContent" source="quizStatistics.fxml"/>
            <fx:include fx:id="studentResultsContent" source="studentResults.fxml"/>
            <fx:include fx:id="assignedSubjectsContent" source="assignedSubjects.fxml"/>
            <fx:include fx:id="createQuizContent" source="createQuiz.fxml" visible="false" managed="false"/>
        </StackPane>
    </center>
</BorderPane>
