<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      spacing="8" alignment="CENTER_LEFT">
    <Button fx:id="editStudentButton" text="Edit" accessibleText="Edit student"
            onAction="#edit" styleClass="row-action"/>
    <Button fx:id="archiveStudentButton" text="Archive" accessibleText="Archive student"
            onAction="#archive" styleClass="row-action, archive-action"/>
</HBox>
