<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="quizora.dashboard.PanelController" prefWidth="1440" prefHeight="900" minWidth="0" minHeight="0"
    styleClass="dashboard-shell" stylesheets="@../../css/dashboard.css">
    <fx:define><ToggleGroup fx:id="navigationGroup"/></fx:define>
    <left>
        <VBox fx:id="sidebarPane" prefWidth="280" minWidth="280" maxWidth="280" styleClass="sidebar">
            <VBox spacing="6" styleClass="brand-block">
                <Label text="Quizora" styleClass="brand-title"/>
                <Label text="Administrator panel" styleClass="role-label"/>
            </VBox>
            <Label text="WORKSPACE" styleClass="navigation-caption"/>
            <VBox spacing="5">
                <ToggleButton fx:id="dashboardButton" text="Dashboard" accessibleText="Dashboard" toggleGroup="$navigationGroup" selected="true" onAction="#navigate" maxWidth="Infinity" wrapText="true" styleClass="navigation-button"/>
                <ToggleButton fx:id="studentManagementButton" text="Student Management" accessibleText="Student Management" toggleGroup="$navigationGroup" selected="false" onAction="#navigate" maxWidth="Infinity" wrapText="true" styleClass="navigation-button"/>
                <ToggleButton fx:id="teacherManagementButton" text="Teacher Management" accessibleText="Teacher Management" toggleGroup="$navigationGroup" selected="false" onAction="#navigate" maxWidth="Infinity" wrapText="true" styleClass="navigation-button"/>
                <ToggleButton fx:id="quizManagementButton" text="Quiz Management" accessibleText="Quiz Management" toggleGroup="$navigationGroup" selected="false" onAction="#navigate" maxWidth="Infinity" wrapText="true" styleClass="navigation-button"/>
                <ToggleButton fx:id="subjectCategoryManagementButton" text="Subject/Category Management" accessibleText="Subject/Category Management" toggleGroup="$navigationGroup" selected="false" onAction="#navigate" maxWidth="Infinity" wrapText="true" styleClass="navigation-button"/>
                <ToggleButton fx:id="reportsButton" text="Reports" accessibleText="Reports" toggleGroup="$navigationGroup" selected="false" onAction="#navigate" maxWidth="Infinity" wrapText="true" styleClass="navigation-button"/>
                <ToggleButton fx:id="resultsButton" text="Results" accessibleText="Results" toggleGroup="$navigationGroup" selected="false" onAction="#navigate" maxWidth="Infinity" wrapText="true" styleClass="navigation-button"/>
                <ToggleButton fx:id="accountManagementButton" text="Account Management" accessibleText="Account Management" toggleGroup="$navigationGroup" selected="false" onAction="#navigate" maxWidth="Infinity" wrapText="true" styleClass="navigation-button"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="sidebar-footer">
                <Button fx:id="logoutButton" text="Logout" accessibleText="Log out and return to login" onAction="#logout" maxWidth="Infinity" styleClass="logout-button"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="workspacePane" accessibleText="Dashboard workspace" styleClass="workspace">
            <fx:include fx:id="dashboardContent" source="overview.fxml"/>
            <fx:include fx:id="studentContent" source="studentManagement.fxml"/>
            <fx:include fx:id="teacherContent" source="teacherManagement.fxml"/>
        </StackPane>
    </center>
</BorderPane>
