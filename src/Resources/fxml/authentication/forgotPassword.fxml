<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import quizora.ui.HugeIcon?>
<StackPane xmlns="http://javafx.com/javafx/26.0.2" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="quizora.controllerAuthentication.forgotPasswordController"
           prefWidth="1000" prefHeight="500" styleClass="login-page"
           stylesheets="@../../css/authentication.css">
    <VBox alignment="CENTER" spacing="8" maxWidth="480" maxHeight="460" styleClass="recovery-card">
        <Label text="Quizora" styleClass="recovery-brand"/>
        <HBox alignment="CENTER" spacing="12" accessibleText="Password recovery progress">
            <Label fx:id="stepOne" text="1  Email" styleClass="recovery-step"/>
            <Separator prefWidth="22"/>
            <Label fx:id="stepTwo" text="2  Verify" styleClass="recovery-step"/>
            <Separator prefWidth="22"/>
            <Label fx:id="stepThree" text="3  Reset" styleClass="recovery-step"/>
        </HBox>
        <VBox fx:id="emailStep" spacing="10">
            <Label text="Forgot password?" styleClass="recovery-title"/>
            <Label text="Enter your registered email to recover your account." wrapText="true" styleClass="recovery-description"/>
            <VBox spacing="6">
                <Label text="Email address" labelFor="$emailField" styleClass="field-label"/>
                <TextField fx:id="emailField" promptText="you@example.com" accessibleText="Registered email address"
                           onAction="#continueRecovery" styleClass="login-field"/>
            </VBox>
        </VBox>
        <VBox fx:id="codeStep" spacing="10" visible="false" managed="false">
            <Label text="Check your email" styleClass="recovery-title"/>
            <Label fx:id="destinationLabel" text="Enter the 6-digit verification code." wrapText="true" styleClass="recovery-description"/>
            <VBox spacing="6">
                <Label text="Verification code" labelFor="$codeField" styleClass="field-label"/>
                <TextField fx:id="codeField" promptText="000000" accessibleText="Six-digit verification code"
                           alignment="CENTER" onAction="#continueRecovery" styleClass="login-field,recovery-code"/>
            </VBox>
            <VBox spacing="2" styleClass="recovery-timing">
                <Label fx:id="sentAtLabel" text="" styleClass="recovery-description"/>
                <Label fx:id="expiresAtLabel" text="" styleClass="recovery-description"/>
                <Label fx:id="countdownLabel" text="" styleClass="recovery-countdown"/>
            </VBox>
            <Button fx:id="resendButton" text="Resend Code" onAction="#resendCode" styleClass="recovery-resend" graphicTextGap="8">
                <graphic><HugeIcon name="refresh"/></graphic>
            </Button>
        </VBox>
        <VBox fx:id="passwordStep" spacing="10" visible="false" managed="false">
            <Label text="Set a new password" styleClass="recovery-title"/>
            <Label text="Use 8-128 characters for your new password." wrapText="true" styleClass="recovery-description"/>
            <VBox spacing="6">
                <Label text="New password" labelFor="$newPasswordField" styleClass="field-label"/>
                <StackPane>
                    <PasswordField fx:id="newPasswordField" promptText="New password" accessibleText="New password"
                                   onAction="#continueRecovery" styleClass="login-field,recovery-password"/>
                    <TextField fx:id="visibleNewPasswordField" promptText="New password" accessibleText="New password visible"
                               visible="false" managed="false" onAction="#continueRecovery" styleClass="login-field,recovery-password"/>
                    <ToggleButton fx:id="showNewPasswordButton" accessibleText="Show new password"
                                  StackPane.alignment="CENTER_RIGHT" styleClass="password-eye"/>
                </StackPane>
            </VBox>
            <VBox spacing="6">
                <Label text="Confirm password" labelFor="$confirmPasswordField" styleClass="field-label"/>
                <StackPane>
                    <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password" accessibleText="Confirm new password"
                                   onAction="#continueRecovery" styleClass="login-field,recovery-password"/>
                    <TextField fx:id="visibleConfirmPasswordField" promptText="Confirm new password" accessibleText="Confirm new password visible"
                               visible="false" managed="false" onAction="#continueRecovery" styleClass="login-field,recovery-password"/>
                    <ToggleButton fx:id="showConfirmPasswordButton" accessibleText="Show confirm new password"
                                  StackPane.alignment="CENTER_RIGHT" styleClass="password-eye"/>
                </StackPane>
            </VBox>
        </VBox>
        <Label fx:id="recoveryStatus" text="" wrapText="true" minHeight="18" maxWidth="Infinity" styleClass="recovery-status"/>
        <Button fx:id="continueButton" text="Continue" onAction="#continueRecovery" defaultButton="true"
                maxWidth="Infinity" styleClass="recovery-primary"/>
        <HBox alignment="CENTER" spacing="26">
            <Hyperlink fx:id="previousButton" text="Back" onAction="#previousStep" styleClass="text-link" graphicTextGap="8">
                <graphic><HugeIcon name="arrow-left-01"/></graphic>
            </Hyperlink>
            <Hyperlink fx:id="loginLink" text="Back to login" onAction="#backToLogin" styleClass="text-link"/>
        </HBox>
    </VBox>
</StackPane>
